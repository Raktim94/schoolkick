#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "schoolkick: your data stays in Docker volumes (schoolkick_schoolkick-pgdata) and your settings and generated passwords in /etc/schoolkick/schoolkick.env, so a later reinstall picks up where you left off. To delete everything for good: sudo docker compose --project-name schoolkick down -v ; sudo rm -rf /etc/schoolkick" >&2
fi
exit 0
