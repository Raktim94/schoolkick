# SchoolKick settings. After editing, run: sudo systemctl restart schoolkick
# Generated on first install; keep it, the database user depends on it.
POSTGRES_PASSWORD=@SECRET@
# Port on this machine that serves SchoolKick.
HOST_PORT=3847
# 127.0.0.1 keeps SchoolKick reachable from this machine only (safe default). Put a reverse proxy or tunnel with HTTPS in front
# of it, or set 0.0.0.0 to serve your network directly once your school exists and SITE_URL is set.
BIND_ADDRESS=127.0.0.1
# Public address people will type. Used for page links, canonical URLs and the sitemap.
SITE_URL=http://localhost:3847
# 1 lets anyone create a new institution. Set 0 once your school exists.
ALLOW_SIGNUP=1
