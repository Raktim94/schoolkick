{
  "name": "campusos",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "build": "npm -w web run build",
    "start": "npm -w server run start",
    "test": "npm -w server test",
    "typecheck": "npm -w server run typecheck && npm -w web run typecheck",
    "e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1"
  }
}
