# Copy to deploy/.env and change every value marked CHANGE.
POSTGRES_PASSWORD=CHANGE-me-to-a-long-random-string
# Public address people will use. Used for links, sitemap and canonical URLs.
SITE_URL=http://localhost:8080
# 1 lets anyone create a new institution on this server. Set 0 after setup if this is a single-school install.
ALLOW_SIGNUP=1
HTTP_PORT=8080
# BIND_ADDRESS=127.0.0.1   # set when a reverse proxy or tunnel on the same host fronts the app
